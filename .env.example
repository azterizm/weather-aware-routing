# Copy this file to .env at the repository root for local development. Never commit .env.

# TomTom routing and geocoding need this key. A free key is available at https://developer.tomtom.com.
TOMTOM_API_KEY=

# An Open-Meteo key switches to the paid service. Leave it empty to use the free service.
OPEN_METEO_API_KEY=

# Django settings for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The place search covers these countries, as comma-separated ISO 3166-1 alpha-2 codes.
GEOCODE_COUNTRY_SET=US
