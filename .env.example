# Copy to .env (repo root) for local development. Never commit .env.

# Required: TomTom API key (routing + geocoding). https://developer.tomtom.com
TOMTOM_API_KEY=

# Optional: Open-Meteo commercial API key. Leave empty to use the free endpoint.
OPEN_METEO_API_KEY=

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Geocoding country filter (ISO 3166-1 alpha-2, comma-separated)
GEOCODE_COUNTRY_SET=US
